{
  "contractVersion": 1,
  "kind": "bypass",
  "note": "The grant below is granted at wall clock 20:00:00 with monotonic counter 5000000 and lasts five minutes, so it expires at wall clock 20:05:00 and at monotonic 5300000. Every case moves one clock, the other, or both, and states which one decides.",
  "cases": [
    {
      "id": "bypass-no-grant-blocks",
      "title": "With no grant, nothing is suppressed",
      "covers": ["BR-01"],
      "given": { "grant": null },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:01:40+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5100000
      },
      "expect": { "suppressesBlock": false, "evaluation": null }
    },
    {
      "id": "bypass-active-inside-window",
      "title": "Inside the window, the block is suppressed",
      "covers": ["BR-01", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:01:40+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5100000
      },
      "expect": { "suppressesBlock": true, "evaluation": "ACTIVE" },
      "atRisk": {
        "platform": "ios",
        "reason": "A five-minute grant cannot be ended by a monitored activity event, because the minimum monitored interval is fifteen minutes. The documented fallback is a fifteen-minute grant; see bypass-fallback-fifteen-minute-grant."
      }
    },
    {
      "id": "bypass-one-second-before-expiry",
      "title": "One second before expiry the grant still holds",
      "covers": ["BR-07", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:04:59+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5299000
      },
      "expect": { "suppressesBlock": true, "evaluation": "ACTIVE" }
    },
    {
      "id": "bypass-exactly-at-expiry-does-not-hold",
      "title": "The expiry instant itself is outside the grant",
      "covers": ["BR-07"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:05:00+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5300000
      },
      "expect": { "suppressesBlock": false, "evaluation": "EXPIRED" }
    },
    {
      "id": "bypass-after-expiry-blocks-again",
      "title": "After the window the block returns",
      "covers": ["BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:10:00+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5600000
      },
      "expect": { "suppressesBlock": false, "evaluation": "EXPIRED" }
    },
    {
      "id": "bypass-does-not-leak-to-another-app",
      "title": "A grant for one application suppresses nothing for another",
      "covers": ["BR-01", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:01:40+09:00",
        "forApp": "app-b",
        "monotonicMillis": 5100000
      },
      "expect": { "suppressesBlock": false, "evaluation": null }
    },
    {
      "id": "bypass-clock-moved-back-still-inside",
      "title": "The device clock is moved back an hour while the grant is genuinely still running",
      "covers": ["BR-07"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T19:01:40+09:00",
        "localTimeNote": "the device clock reads 19:01:40, an hour behind the moment the grant was taken",
        "forApp": "app-a",
        "monotonicMillis": 5100000
      },
      "expect": { "suppressesBlock": true, "evaluation": "ACTIVE" }
    },
    {
      "id": "bypass-clock-moved-back-does-not-extend-the-grant",
      "title": "Moving the device clock back does not buy more time",
      "covers": ["BR-07", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T19:06:40+09:00",
        "localTimeNote": "the device clock reads 19:06:40, which is fifty-eight minutes before the stored expiry, while the monotonic counter says the five minutes are already spent",
        "forApp": "app-a",
        "monotonicMillis": 5400000
      },
      "expect": { "suppressesBlock": false, "evaluation": "EXPIRED" }
    },
    {
      "id": "bypass-clock-moved-forward-does-not-shorten-the-grant",
      "title": "Moving the device clock forward does not cut the grant short",
      "covers": ["BR-07"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T21:01:40+09:00",
        "localTimeNote": "the device clock reads 21:01:40, an hour ahead, while only one hundred seconds of the grant have actually passed",
        "forApp": "app-a",
        "monotonicMillis": 5100000
      },
      "expect": { "suppressesBlock": true, "evaluation": "ACTIVE" }
    },
    {
      "id": "bypass-survives-a-reboot-inside-the-window",
      "title": "After a reboot, a grant whose window has not passed still holds",
      "covers": ["BR-07", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:02:00+09:00",
        "localTimeNote": "the monotonic counter has restarted, which is how a reboot is recognised; only the device clock remains usable",
        "forApp": "app-a",
        "monotonicMillis": 3000
      },
      "expect": { "suppressesBlock": true, "evaluation": "ACTIVE_AFTER_REBOOT" },
      "atRisk": {
        "platform": "ios",
        "reason": "Recognising a reboot from a monotonic counter running backwards assumes the platform exposes one that resets at boot. If iOS cannot express this, the grant model changes for both platforms."
      }
    },
    {
      "id": "bypass-does-not-resurrect-after-a-reboot",
      "title": "A reboot does not bring an expired grant back",
      "covers": ["BR-07", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:30:00+09:00",
        "localTimeNote": "twenty-five minutes past the expiry, and the monotonic counter has restarted",
        "forApp": "app-a",
        "monotonicMillis": 3000
      },
      "expect": { "suppressesBlock": false, "evaluation": "EXPIRED_AFTER_REBOOT" },
      "atRisk": {
        "platform": "ios",
        "reason": "Same reason as bypass-survives-a-reboot-inside-the-window: the reboot signal itself is what may not map."
      }
    },
    {
      "id": "bypass-discarded-when-clock-predates-the-grant",
      "title": "After a reboot, a device clock earlier than the grant's own creation makes the grant untrustworthy",
      "covers": ["BR-07"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 5
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T19:00:00+09:00",
        "localTimeNote": "the device clock now reads an hour before the grant was created, so neither clock can be trusted",
        "forApp": "app-a",
        "monotonicMillis": 3000
      },
      "expect": { "suppressesBlock": false, "evaluation": "DISCARDED_CLOCK_MOVED_BEFORE_GRANT" },
      "atRisk": {
        "platform": "ios",
        "reason": "Depends on the same reboot signal, and on being allowed to discard a grant the user was promised. Confirm the user-facing wording alongside it."
      }
    },
    {
      "id": "bypass-fallback-fifteen-minute-grant",
      "title": "A fifteen-minute grant, the documented fallback where a shorter one cannot be honoured",
      "covers": ["BR-07", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 15
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:14:00+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5840000
      },
      "expect": { "suppressesBlock": true, "evaluation": "ACTIVE" }
    },
    {
      "id": "bypass-fallback-fifteen-minute-grant-expires",
      "title": "The fifteen-minute fallback grant expires on the same rule as any other",
      "covers": ["BR-07", "BR-12"],
      "given": {
        "grant": {
          "forApp": "app-a",
          "grantedAtWallClock": "2026-07-27T20:00:00+09:00",
          "grantedAtMonotonicMillis": 5000000,
          "durationMinutes": 15
        }
      },
      "when": {
        "zone": "Asia/Tokyo",
        "instant": "2026-07-27T20:15:00+09:00",
        "forApp": "app-a",
        "monotonicMillis": 5900000
      },
      "expect": { "suppressesBlock": false, "evaluation": "EXPIRED" }
    }
  ]
}
